#!/usr/bin/env bash
# Uses explicitly supplied cached Kotlin dependencies; no Gradle or downloads.
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
: "${JAVA_HOME:?Set JAVA_HOME}"
: "${KOTLIN_STDLIB:?Set KOTLIN_STDLIB}"
: "${KOTLIN_COMPILER_CLASSPATH:?Set KOTLIN_COMPILER_CLASSPATH}"
: "${JSON_JAR:?Set JSON_JAR to a host org.json jar}"
output=${CARGO_TARGET_DIR:-target}
mkdir -p "$output/jni-host/kotlin"
"$JAVA_HOME/bin/java" -Xmx384m -cp "$KOTLIN_COMPILER_CLASSPATH" org.jetbrains.kotlin.cli.jvm.K2JVMCompiler \
  -no-stdlib -no-reflect -jvm-target 17 -classpath "$JSON_JAR:$KOTLIN_STDLIB" \
  -d "$output/jni-host/kotlin" bindings/android/kotlin/dev/avillagran/t3/T3Client.kt \
  bindings/android/tests/dev/avillagran/t3/KotlinFixture.kt
"$JAVA_HOME/bin/java" --add-modules jdk.httpserver -Djava.library.path="$output/jni-host" \
  -cp "$output/jni-host/kotlin:$JSON_JAR:$KOTLIN_STDLIB" dev.avillagran.t3.KotlinFixtureKt
