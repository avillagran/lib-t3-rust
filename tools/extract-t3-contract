#!/usr/bin/env python3
"""Extract T3's RPC surface (tag, stream, scope) into tests/fixtures/t3-contract.json.

Usage: tools/extract-t3-contract /path/to/t3code [output.json]

Reads only source text from the T3 checkout (packages/contracts/src and
apps/server/src/auth/RpcAuthorization.ts); runs nothing from it. The JSON pins
the commit, so `tests/api_contract.rs` can check the typed API registry against
the exact contract it was written for.
"""
import json
import pathlib
import re
import subprocess
import sys


def read(root, rel):
    return (root / rel).read_text(encoding="utf-8")


def block(text, start_pattern):
    """The `{ ... }` body that follows the first match of start_pattern."""
    match = re.search(start_pattern, text)
    if not match:
        sys.exit(f"pattern not found: {start_pattern}")
    i = text.index("{", match.end() - 1)
    depth = 0
    for j in range(i, len(text)):
        if text[j] == "{":
            depth += 1
        elif text[j] == "}":
            depth -= 1
            if depth == 0:
                return text[i + 1 : j]
    sys.exit(f"unterminated block: {start_pattern}")


def methods(body):
    return dict(re.findall(r'^\s*(\w+):\s*"([^"]+)"', body, re.M))


def main():
    if len(sys.argv) not in (2, 3):
        sys.exit(__doc__)
    root = pathlib.Path(sys.argv[1]).resolve()
    out = pathlib.Path(sys.argv[2]) if len(sys.argv) == 3 else pathlib.Path(__file__).resolve().parent.parent / "tests/fixtures/t3-contract.json"
    src = pathlib.Path("packages/contracts/src")
    rpc = read(root, src / "rpc.ts")
    orchestration = read(root, src / "orchestrationV2.ts")
    auth = read(root, src / "auth.ts")
    guarded = read(root, src / "clientRpcPermissions.ts")
    authorization = read(root, "apps/server/src/auth/RpcAuthorization.ts")

    namespaces = {
        "WS_METHODS": methods(block(rpc, r"export const WS_METHODS = \{")),
        "ORCHESTRATION_V2_WS_METHODS": methods(block(orchestration, r"export const ORCHESTRATION_V2_WS_METHODS = \{")),
    }
    scopes = dict(re.findall(r'export const (Auth\w+Scope) = "([^"]+)"', auth))

    def tag_of(namespace, key):
        try:
            return namespaces[namespace][key]
        except KeyError:
            sys.exit(f"unknown method {namespace}.{key}")

    # Static scopes: client-guarded first, then the server table (which spreads it).
    required = {}
    for text, start in ((guarded, r"export const CLIENT_GUARDED_RPC_SCOPES = \{"), (authorization, r"export const RPC_REQUIRED_SCOPES = \{")):
        for namespace, key, scope in re.findall(r"\[(WS_METHODS|ORCHESTRATION_V2_WS_METHODS)\.(\w+)\]:\s*(Auth\w+Scope)", block(text, start)):
            required[tag_of(namespace, key)] = scopes[scope]

    # Payload-dependent scopes: every `method === X.key` branch in either file.
    dynamic = set()
    for text in (guarded, authorization):
        for namespace, key in re.findall(r"method === (WS_METHODS|ORCHESTRATION_V2_WS_METHODS)\.(\w+)", text):
            dynamic.add(tag_of(namespace, key))

    # Streams: `Rpc.make(X.key, { ... stream: true ... })`.
    # Only tags with an `Rpc.make` are served; WS_METHODS also keeps retired names.
    streams, every = set(), set()
    for match in re.finditer(r"Rpc\.make\(\s*(WS_METHODS|ORCHESTRATION_V2_WS_METHODS)\.(\w+),", rpc):
        every.add(tag_of(match.group(1), match.group(2)))
        body = block(rpc[match.start() :], r"Rpc\.make\([^,]+,\s*\{")
        if re.search(r"^\s*stream:\s*true", body, re.M):
            streams.add(tag_of(match.group(1), match.group(2)))

    result = {}
    for tag in sorted(every):
        if tag not in required and tag not in dynamic:
            sys.exit(f"no scope for {tag}")
        result[tag] = {"stream": tag in streams, "scope": required.get(tag), "dynamic": tag in dynamic}

    # Command types: the top-level `type` literal of each struct in the union.
    start = orchestration.index("export const OrchestrationV2Command = Schema.Union([")
    end = orchestration.index("]);", start)
    command_types = sorted(set(re.findall(r'^    type: Schema\.Literal\("([^"]+)"\)', orchestration[start:end], re.M)))

    commit = subprocess.run(["git", "-C", str(root), "rev-parse", "--short=9", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    document = {"contract": f"t3code@{commit}", "methods": result, "commandTypes": command_types}
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(document, indent=1, sort_keys=True) + "\n", encoding="utf-8")
    print(f"{out}: {len(result)} methods ({len(streams)} streams), {len(command_types)} command types, {document['contract']}")


if __name__ == "__main__":
    main()
