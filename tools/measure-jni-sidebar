#!/usr/bin/env python3
"""Measure isolated host JVM/JNI sidebar peaks after building tools/test-jni."""
import json
import os
from pathlib import Path
import subprocess

output = Path(os.environ.get("CARGO_TARGET_DIR", "target")).resolve() / "jni-host"
java = str(Path(os.environ["JAVA_HOME"]) / "bin/java")
results = []
for mib in (9, 16, 32, 64):
    process = subprocess.Popen([
        java, "-Xmx2g", "--add-modules", "jdk.httpserver",
        f"-Djava.library.path={output}", "-cp", str(output / "java"),
        "dev.avillagran.t3.T3Native", str(mib),
    ])
    _, status, usage = os.wait4(process.pid, 0)
    process.returncode = os.waitstatus_to_exitcode(status)
    results.append({"mib": mib, "peak_rss_kib": usage.ru_maxrss, "exit": process.returncode})
print(json.dumps(results, indent=2))
raise SystemExit(any(row["exit"] for row in results))
